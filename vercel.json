{
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 30
    },
    "api/oauth.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth?op=prm" },
    { "source": "/.well-known/oauth-protected-resource/api/mcp", "destination": "/api/oauth?op=prm" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth?op=as" },
    { "source": "/oauth/register", "destination": "/api/oauth?op=register" },
    { "source": "/oauth/authorize", "destination": "/api/oauth?op=authorize" },
    { "source": "/oauth/callback", "destination": "/api/oauth?op=callback" },
    { "source": "/oauth/token", "destination": "/api/oauth?op=token" }
  ]
}
