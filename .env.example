LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_TOKEN=
# Public origin of this deployment, no trailing slash; it is the OAuth issuer.
MCP_PUBLIC_URL=https://meiri-baoji-leaderboard.vercel.app
# At least 32 random characters; seals clients, codes and tokens. Rotating it signs everyone out.
MCP_OAUTH_SECRET=
# Sign in with openTag: issuer and the openTag app registered for this MCP.
OPENTAG_OAUTH_ISSUER=https://app.opentag.build/api/v1/auth
OPENTAG_OAUTH_CLIENT_ID=
OPENTAG_OAUTH_CLIENT_SECRET=
MCP_ALLOWED_ORIGINS=
